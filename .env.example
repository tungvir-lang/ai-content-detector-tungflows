# ============================================================
#  MeHeal Clinic Bot - Cấu hình môi trường
#  Sao chép file này thành .env rồi điền thông tin của bạn.
# ============================================================

# --- Máy chủ ---
PORT=8787
NODE_ENV=production

# --- Bảo mật hệ thống (BẮT BUỘC đổi trên máy thật) ---
# Chuỗi bí mật ký JWT phiên đăng nhập admin. Đổi thành chuỗi ngẫu nhiên dài.
JWT_SECRET=doi-chuoi-nay-thanh-mot-gia-tri-bi-mat-ngau-nhien

# Khóa bản quyền (License) do NHÀ CUNG CẤP phát hành bằng lệnh: npm run keygen
# Chuỗi bí mật dùng để ký & xác thực license. Chỉ nhà cung cấp giữ.
LICENSE_SECRET=meheal-vendor-master-secret-2026

# Mật khẩu admin khởi tạo lần đầu (sau đó đổi trong phần Cài đặt).
ADMIN_DEFAULT_PASSWORD=admin@123

# --- Tích hợp AI (tùy chọn - có thể cấu hình trong trang Admin) ---
# Nhà cung cấp mặc định: gemini | openai | compatible
AI_PROVIDER=gemini

# Google Gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

# OpenAI
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# OpenAI-compatible (OpenRouter, DeepSeek, Groq, Ollama...) - đề xuất model thay thế
# Ví dụ Ollama nội bộ: http://localhost:11434/v1 , model llama3.1
COMPATIBLE_BASE_URL=
COMPATIBLE_API_KEY=
COMPATIBLE_MODEL=

# --- Cơ sở dữ liệu ---
# Đường dẫn file SQLite (mặc định ./data/meheal.db). Chạy được ngay, không cần server DB.
DATABASE_PATH=./data/meheal.db
