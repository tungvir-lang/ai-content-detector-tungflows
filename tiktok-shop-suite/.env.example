# ─────────────────────────────────────────────────────────────────────────────
# TikTok Shop Automation Suite — environment template
# Copy to .env and fill in. NEVER commit the real .env (it is gitignored).
# Load it with:  node --env-file=.env ...   (or your process manager)
# ─────────────────────────────────────────────────────────────────────────────

# Safety: when true, automation computes and logs actions but never mutates
# live budgets/bids/posts. Flip to false only when you have reviewed the
# dry-run output and are ready to let it act. Default: true.
TTS_DRY_RUN=true

# --- TikTok Shop Partner API (open-api.tiktokglobalshop.com) ------------------
# From https://partner.tiktokshop.com — your app's key/secret and the
# shop_cipher returned when the seller authorizes your app.
TTS_SHOP_APP_KEY=
TTS_SHOP_APP_SECRET=
TTS_SHOP_CIPHER=
TTS_SHOP_ACCOUNT_ID=default_shop
# Optional overrides:
# TTS_SHOP_BASE_URL=https://open-api.tiktokglobalshop.com
# TTS_SHOP_API_VERSION=202309

# --- TikTok Marketing API (business-api.tiktok.com) ---------------------------
# From https://ads.tiktok.com/marketing_api — developer app id/secret and the
# advertiser_id of the ad account you manage.
TTS_MARKETING_APP_ID=
TTS_MARKETING_APP_SECRET=
TTS_MARKETING_ADVERTISER_ID=
# Optional:
# TTS_MARKETING_BASE_URL=https://business-api.tiktok.com/open_api/v1.3

# --- TikTok Content Posting API (open.tiktokapis.com) -------------------------
# From https://developers.tiktok.com — client key/secret for an app with the
# video.publish scope, and the open_id of the authorized creator account.
TTS_CONTENT_CLIENT_KEY=
TTS_CONTENT_CLIENT_SECRET=
TTS_CONTENT_OPEN_ID=default_creator
# Optional:
# TTS_CONTENT_BASE_URL=https://open.tiktokapis.com/v2

# --- Local runtime ------------------------------------------------------------
TTS_DB_PATH=./data/tts.db
TTS_SERVER_PORT=4000
LOG_LEVEL=info

# Worker cadences (milliseconds) — how often the always-on worker acts.
TTS_DISPATCH_INTERVAL_MS=60000
TTS_REPORT_INTERVAL_MS=3600000
TTS_AUTOMATION_INTERVAL_MS=21600000
